        {
            "name": "DAPLink (pyOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "CMake: build",
            "servertype": "pyocd",
            "cwd": "${workspaceFolder}",
            "targetId": "stm32f407zgtx",
            "executable": "${workspaceFolder}/build/Debug/f4oled.elf",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "overrideGDBServerStartedRegex": "GDB server listening on port\\s+\\d+",
            "serverArgs": [
                "-f",
                "10000000",
                "-O",
                "connect_mode=pre-reset",
                "-O",
                "reset_type=sysresetreq",
                "-O",
                "smart_flash=false",
                "-O",
                "cmsis_dap.deferred_transfers=false",
                "-O",
                "cmsis_dap.limit_packets=true"
